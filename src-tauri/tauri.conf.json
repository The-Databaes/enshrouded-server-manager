{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "enshrouded-server-manager",
  "version": "0.1.0",
  "identifier": "dev.dissemblir.esm",
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build:vite",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "label": "splashscreen",
        "title": "Enshrouded Server Manager",
        "url": "splashscreen.html",
        "width": 600,
        "height": 360,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "backgroundColor": "#0C0916"
      },
      {
        "label": "main",
        "title": "Enshrouded Server Manager",
        "width": 1280,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 680,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGOEU2NDcwN0ZGRkExQTcKUldTbm9mOS9jR1NPNzV5cUt1a053VmFpRTdUNHRFclRkS0d3WnhkMS9meTNpV05BdzBYYk4yRUIK",
      "endpoints": [
        "https://github.com/The-Databaes/enshrouded-server-manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
